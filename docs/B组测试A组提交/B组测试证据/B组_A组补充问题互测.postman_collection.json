{
  "info": {
    "_postman_id": "6e92ff76-5647-4bbb-a8b7-1cbac9cb9096",
    "name": "B组_A组补充问题互测",
    "description": "复核 A-12 角色参数边界和 A-19 可选解除说明。角色 ID 与黑名单 ID 均从本次 API 响应动态取得。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 管理员真实登录",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('登录返回 200', () => pm.response.to.have.status(200));",
              "const loginData = pm.response.json();",
              "pm.test('登录响应包含 Token', () => pm.expect(loginData.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('adminToken', loginData.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"a_group_admin\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "02 动态取得已有角色 ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('角色列表返回 200', () => pm.response.to.have.status(200));",
              "const roleData = pm.response.json();",
              "pm.test('至少存在一个角色', () => pm.expect(roleData).to.be.an('array').that.is.not.empty);",
              "pm.collectionVariables.set('existingRoleId', roleData[0].roleID);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/roles"
      }
    },
    {
      "name": "03 动态取得已解除黑名单 ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('已解除黑名单列表返回 200', () => pm.response.to.have.status(200));",
              "const blacklistData = pm.response.json();",
              "pm.test('至少存在一条已解除记录', () => pm.expect(blacklistData.items).to.be.an('array').that.is.not.empty);",
              "pm.collectionVariables.set('releasedBlacklistId', blacklistData.items[0].blacklistId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/blacklist?status=RELEASED&page=1&pageSize=20"
      }
    },
    {
      "name": "A-12 补充1 重复 roleID 应返回409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('重复 roleID 返回 409', () => pm.response.to.have.status(409));",
              "pm.test('响应不泄露 Oracle 异常', () => pm.expect(pm.response.text()).not.to.include('ORA-'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roleID\": \"{{existingRoleId}}\",\n  \"roleName\": \"VET\",\n  \"permissionScope\": \"CAT_VIEW\",\n  \"description\": \"重复角色ID边界复核\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/roles"
      }
    },
    {
      "name": "A-12 补充2 省略 roleID 应返回400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('省略 roleID 返回 400', () => pm.response.to.have.status(400));",
              "pm.test('响应不泄露 Oracle 异常', () => pm.expect(pm.response.text()).not.to.include('ORA-'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roleName\": \"VET\",\n  \"permissionScope\": \"CAT_VIEW\",\n  \"description\": \"缺少角色ID边界复核\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/roles"
      }
    },
    {
      "name": "A-19 补充1 空对象应按资源状态返回409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('可选 releaseReason 省略后返回 409', () => pm.response.to.have.status(409));",
              "pm.test('响应说明记录已经解除', () => pm.expect(pm.response.text()).to.include('已被解除'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/blacklist/{{releasedBlacklistId}}/release"
      }
    },
    {
      "name": "A-19 补充2 提供 releaseReason 后返回409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('提供 releaseReason 后返回 409', () => pm.response.to.have.status(409));",
              "pm.test('响应说明记录已经解除', () => pm.expect(pm.response.text()).to.include('已被解除'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"releaseReason\": \"重复解除边界复核\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/blacklist/{{releasedBlacklistId}}/release"
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:5047"},
    {"key": "testPassword", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "existingRoleId", "value": ""},
    {"key": "releasedBlacklistId", "value": ""}
  ]
}
