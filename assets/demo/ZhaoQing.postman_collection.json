{
  "info": {
    "_postman_id": "9fa3cd0d-5857-42b3-95f0-c75bad4adc61",
    "name": "Campus Stray Cat - 赵晴模块",
    "description": "校园区域、服务点、猫窝维护和目击记录接口的顺序化冒烟及回归测试。请先执行 database/insert_demo_data.sql。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5047" },
    { "key": "areaId", "value": "" },
    { "key": "pointId", "value": "" },
    { "key": "maintenanceId", "value": "" },
    { "key": "sightingId", "value": "" },
    { "key": "catId", "value": "demo-cat-campus-001" },
    { "key": "userId", "value": "demo-user-zhaoqing" }
  ],
  "item": [
    {
      "name": "01 健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('数据库连接正常', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 查询区域层级",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/campus-areas/hierarchy"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('返回区域数组', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 新增测试区域",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"areaName\": \"Postman 测试区域\",\n  \"campusName\": \"四平路校区\",\n  \"areaType\": \"测试区域\",\n  \"riskLevel\": \"低\"\n}"
        },
        "url": "{{baseUrl}}/api/campus-areas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('区域创建成功', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('areaId', pm.response.json().areaID);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 更新测试区域",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"areaName\": \"Postman 测试区域（已更新）\",\n  \"campusName\": \"四平路校区\",\n  \"areaType\": \"测试区域\",\n  \"riskLevel\": \"中\"\n}"
        },
        "url": "{{baseUrl}}/api/campus-areas/{{areaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('区域更新成功', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 新增服务点",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"areaID\": \"{{areaId}}\",\n  \"pointName\": \"Postman 测试猫窝\",\n  \"pointType\": \"猫窝\",\n  \"longitude\": 121.5064,\n  \"latitude\": 31.2822,\n  \"facilityStatus\": \"正常\",\n  \"deployTime\": \"2026-07-21T08:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/api/service-points"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('服务点创建成功', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('pointId', pm.response.json().pointID);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 按区域查询服务点",
