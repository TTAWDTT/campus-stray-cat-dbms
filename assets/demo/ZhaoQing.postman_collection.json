      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('查询到测试服务点', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
